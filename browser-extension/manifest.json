{
  "manifest_version": 3,
  "name": "VisionMod Browser Music Bridge",
  "version": "2.0.1",
  "description": "Pair Spotify / SoundCloud web music with a local VisionMod Minecraft client. Sends title, artist and playback position only.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:38567/*"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [
    {"matches": ["https://open.spotify.com/*", "https://soundcloud.com/*", "https://www.soundcloud.com/*"],
      "js": ["content.js"], "run_at": "document_idle"}
  ],
  "options_page": "options.html",
  "action": {"default_title": "VisionMod Music Bridge", "default_popup": "options.html"}
}
